# GEMINI_API_KEY: Required only if Gemini API is used.
# Keep commented unless explicitly configured in runtime secrets.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# GITHUB_REPOSITORY: Format owner/repo untuk cek & verifikasi update APK dari GitHub Releases
GITHUB_REPOSITORY=deckyp5758-eng/Pattern-PRO

# APP_RELEASE_TAG: Tag versi rilis APK (SemVer, misal v1.0.0 atau diisi oleh GitHub Actions tag)
APP_RELEASE_TAG=v1.0.0
